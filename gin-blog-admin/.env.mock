# mock 模式: 用于产出脱离后端的静态演示页面
# 构建命令: pnpm build:mock (资源 base 可用 --base 覆盖, 见 CI)

# 资源公共路径, 需要以 / 开头和结尾
VITE_PUBLIC_PATH = '/'

# 服务器路径（用于本地文件上传加载图片）: mock 模式下不使用
VITE_SERVER_URL = ''

# 基础 API: mock 模式下不会真正发出请求, 仅作为 axios baseURL 占位
VITE_BASE_API = '/api'

# 是否后端生成路由
VITE_BACK_ROUTER = true

# 登录时是否需要验证码, 需要在 index.html 引入 TCaptcha.js
VITE_USE_CAPTCHA = false

# 是否使用 mock 数据: true 时不请求后端, 由 src/mock 提供假数据
VITE_USE_MOCK = true

# 静态托管下直接访问子路径会 404, 故 mock 构建改用 hash 路由
VITE_USE_HASH_ROUTER = true
